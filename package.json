{
  "name": "aiesec-approval-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "configure": "node scripts/configure-entity.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tus-js-client": "4.3.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.10.1",
    "vite": "^7.1.0"
  }
}
